# ---- inference backend ----------------------------------------------------
# "ollama" (default, native token counts) or "openai" (llama.cpp servers)
BACKEND=ollama
# "auto" probes localhost:11434, then this host's default gateway :11434
# (the dev laptop, when CortexEdge runs inside the LXC container).
OLLAMA_API_URL=auto
#SMALL_MODEL_URL=http://127.0.0.1:8101/v1/chat/completions
#MEDIUM_MODEL_URL=http://127.0.0.1:8102/v1/chat/completions

# Ollama model names per route. Every default below names a model that is
# importable from GGUF files already on disk (scripts/import_local_models.sh).
MODEL_SMALL=qwen2.5:1.5b
MODEL_MEDIUM=gemma2:2b
MODEL_MOE=qwen2.5:1.5b
MODEL_LARGE=llama3.1:8b

# ---- local latency tuning (see docs/LOCAL_LATENCY.md) ---------------------
# keep the model resident between requests (a cold load costs 4-6 s on CPU)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_BATCH=512
OLLAMA_NUM_THREAD=0
OLLAMA_WARMUP=1
OLLAMA_EMBED_MODEL=nomic-embed-text
# the embedder must not hold a resident slot forever (it evicts chat tiers)
OLLAMA_EMBED_KEEP_ALIVE=30m
# Ollama scheduler slots: small + medium + embedder
OLLAMA_MAX_LOADED_MODELS=3

# ---- pooled: peer-to-peer browser inference -------------------------------
# github.com/Nehanth/pooled — run one open model across the GPUs of every
# device in a room (browser tabs, WebGPU + WebRTC). The room can serve its
# model to any OpenAI-compatible client:
#   npx @pooled/cli serve "https://pooled.run/r/<code>#k=..."
# and CortexEdge registers that bridge as the `pooled` route.
POOLED_ENABLED=1
POOLED_BASE_URL=http://127.0.0.1:8080/v1
#POOLED_API_KEY=...
POOLED_MODEL=pooled
#POOLED_ROOM_LINK=https://pooled.run/r/XXXXXX#k=...

# ---- cloud fallback (OpenAI-compatible endpoint) --------------------------
#CLOUD_MODEL_URL=https://openrouter.ai/api/v1/chat/completions
#CLOUD_API_KEY=sk-...
#CLOUD_MODEL=openai/gpt-4o-mini

# ---- RAG ------------------------------------------------------------------
# Embeddings come from Ollama (`OLLAMA_EMBED_MODEL`) when that model is
# available; sentence-transformers is the fallback, hashing is the last resort.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_GENERATION_ROUTE=medium
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=70

# ---- cache ----------------------------------------------------------------
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- limits ---------------------------------------------------------------
MAX_CPU_TEMPERATURE_C=75.0
MINIMUM_FREE_RAM_MB=1500
REQUEST_TIMEOUT_S=90

# ---- routing defaults -----------------------------------------------------
DEFAULT_ROUTER=rule
DEFAULT_POLICY=public
QUALITY_TARGET=0.6

# ---- web search fallback (optional) ---------------------------------------
#EXA_API_KEY=...
