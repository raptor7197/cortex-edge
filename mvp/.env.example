# Copy to mvp/.env and fill in optional keys.

# --- Cloud comparison (compare_cloud.py) ---
# OpenRouter (one key for many models): https://openrouter.ai/keys
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_API_KEY=
# comma-separated model ids, e.g.:
# CLOUD_MODELS=meta-llama/llama-3.1-8b-instruct:free,openai/gpt-4o-mini

# --- Web search (search.py) ---
# Exa AI neural search (optional; DDG works without a key)
EXA_API_KEY=
